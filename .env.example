# Copie para .env (ou defina no painel do seu alojamento).
# Não committe o ficheiro .env.

PORT=3000
NODE_ENV=development

# Segredo das sessões (obrigatório em produção; gere com: openssl rand -hex 32).
# Se ficar vazio, é gerado e guardado na base de dados (tabela settings).
JWT_SECRET=

# PostgreSQL. Se estiver definida, a app NÃO usa SQLite.
# Na Render use a Internal Database URL (sem SSL). A URL externa (host *.render.com)
# liga com TLS e rejectUnauthorized=false. DATABASE_SSL=true/false força o modo.
# DATABASE_URL=postgres://utilizador:palavra-passe@localhost:5432/portaria
# DATABASE_SSL=
# DATABASE_POOL_MAX=5
# DATABASE_SCHEMA=

# SQLite — só quando DATABASE_URL não está definida.
DB_FILE=./data/condominio.db

# Primeiro arranque, e só se a tabela users estiver vazia (nunca apaga dados existentes):
# SEED=0           não cria contas nenhumas
# SEED_DEMO=false  cria apenas o administrador (recomendado em produção)
# SEED_DEMO omitida cria moradores, seguranças e visitas de demonstração
SEED=1
# SEED_DEMO=false
# ADMIN_PASSWORD=troque-esta-palavra-passe

# Web Push (opcional: se vazio, as chaves são geradas e guardadas na BD)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@condominio.ao

# 1 = permitir cookies sem HTTPS em produção (apenas redes locais de teste)
INSECURE_COOKIES=0

# 1 = não enviar Web Push
# DISABLE_PUSH=1

# Tentativas de login por janela de 10 minutos
# LOGIN_RATE_LIMIT=30

# Fuso horário do condomínio
# APP_TZ=Africa/Luanda
